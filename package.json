{
  "name": "dsh-claude-ui",
  "version": "0.4.7",
  "description": "Claude Desktop 风格的 DeepSeek Harness Web UI：暖色调主题 + 布局细节，并默认开启 dshmarket 的侧栏插件市场入口",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    },
    "manifestVersion": 1
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin"
  ],
  "license": "MIT",
  "peerDependencies": {
    "dshmarket": ">=1.73.0"
  },
  "peerDependenciesMeta": {
    "dshmarket": {
      "optional": true
    }
  }
}
